{
  // Keep static hosting separate from vinext's Worker/SSR platform detection.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vframes",
  "account_id": "d6b72c2632db34a5e1ba0bd3a3bad5f5",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vframes.taek.tech",
      "zone_id": "133b1865bbc9ed2c860900909fce854a",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  }
}
